# ─── Database (ZORUNLU) ─────────────────────────────
# Docker Compose kullanıyorsan bu otomatik oluşur, değiştirme.
# Standalone kurulumda kendi PostgreSQL bağlantını yaz.
DATABASE_URL="postgresql://karman:GÜÇLÜ_ŞİFRE@db:5432/karman?schema=public"

# Docker Compose için ayrı değişkenler (compose otomatik kullanır)
POSTGRES_USER="karman"
POSTGRES_PASSWORD="GÜÇLÜ_ŞİFRE"
POSTGRES_DB="karman"

# ─── JWT (ZORUNLU) ──────────────────────────────────
# Her ikisi de benzersiz ve güçlü olmalı: openssl rand -base64 32
JWT_SECRET="BURAYA_GÜÇLÜ_RANDOM_STRING"
JWT_REFRESH_SECRET="BURAYA_FARKLI_GÜÇLÜ_RANDOM_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────
# Tüm origin'lere izin ver (mobil uygulama için * yeterli)
CORS_ORIGIN="*"

# ─── RevenueCat (opsiyonel) ──────────────────────────
# Premium abonelik webhook doğrulaması için.
# RevenueCat dashboard > Integrations > Webhooks > Auth Header
REVENUECAT_WEBHOOK_SECRET=""
